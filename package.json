{
  "name": "project-control-center",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test --test-reporter=./scripts/test-reporter.mjs --test-timeout=120000 tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:fixture": "node scripts/test-worker.mjs --target local-fixture",
    "test:attachments-r2": "node --experimental-strip-types scripts/test-attachments-r2.mjs",
    "test:attachments-http": "node scripts/test-worker.mjs --target local-fixture --with-r2",
    "test:e2e:r2": "playwright test --config playwright.r2.config.ts",
    "test:attachment-recovery-r2": "node --experimental-strip-types scripts/test-attachment-recovery-r2.mjs",
    "test:generation-d1": "node --experimental-strip-types scripts/probe-generation-d1.mjs",
    "test:workspace-d1": "node --experimental-strip-types scripts/test-workspace-d1.mjs",
    "test:sources-d1": "node --experimental-strip-types scripts/test-sources-d1.mjs",
    "test:reviews-d1": "node --experimental-strip-types scripts/test-reviews-d1.mjs",
    "test:scheduled-backup-d1": "node --experimental-strip-types scripts/test-scheduled-backup-d1.mjs",
    "test:reviews-migration-d1": "node --experimental-strip-types scripts/test-reviews-migration-d1.mjs",
    "test:scheduled-source-d1": "node --experimental-strip-types scripts/test-scheduled-source-d1.mjs",
    "test:bridge": "node --test --test-timeout=30000 bridge/test/*.test.mjs",
    "test:runtime-d1": "node --experimental-strip-types scripts/test-runtime-d1.mjs",
    "package:bridge": "node scripts/package-bridge.mjs",
    "test:agents-d1": "node --experimental-strip-types scripts/test-agents-d1.mjs",
    "test:recovery-segments-d1": "node --experimental-strip-types scripts/test-recovery-segments-d1.mjs",
    "test:recovery-maintenance-d1": "node --experimental-strip-types scripts/test-recovery-maintenance-d1.mjs",
    "test:agent-artifacts-r2": "node --experimental-strip-types scripts/test-agent-artifacts-r2.mjs",
    "test:benchmark": "node --experimental-strip-types scripts/benchmark-workspace.mjs",
    "test:fixture-proxy": "node --test tests/fixture-proxy-lifecycle.test.mjs tests/fixture-worker-log.test.mjs",
    "prebuild": "node scripts/package-local-companion.mjs",
    "test:companion": "node --experimental-strip-types --test --test-timeout=30000 tests/local-analysis-contract.test.mjs tests/local-companion.test.mjs tests/local-companion-package.test.mjs tests/local-chat-context.test.mjs tests/local-chat-selection.test.mjs tests/local-claude-chat-context.test.mjs tests/local-analysis-prompt.test.mjs tests/local-claude-provider.test.mjs tests/local-analysis-run.test.mjs tests/local-companion-cli.test.mjs tests/local-folder-picker.test.mjs tests/local-personal-connector.test.mjs",
    "test:github": "node --experimental-strip-types --test --test-timeout=30000 tests/github-analysis-contract.test.mjs tests/github-analysis-client.test.ts tests/github-analysis.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "json-rpc-2.0": "1.7.1",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
